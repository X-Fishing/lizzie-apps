# Credenciais da loja, para os scripts de administracao rodarem localmente.
# Sao os MESMOS dois valores que voce colou na tela "Loja do site".
#
# COMO USAR
#   1. Copie para  supabase/.env.nuvemshop.loja  (sem o .example)
#   2. Preencha os dois campos
#   3. Rode:  node scripts/nuvemshop-webhook.mjs
#
# Gitignored pelo padrao .env.* do .gitignore. Guarde junto com o .env
# da raiz no seu backup.

# O user_id que veio na troca do token (mesmo numero do store_id)
NUVEMSHOP_STORE_ID=

# O access token da loja
NUVEMSHOP_ACCESS_TOKEN=
