# Troca do "code" da instalacao pelos valores finais (access_token + store_id).
#
# COMO USAR
#   1. Copie para  supabase/.env.nuvemshop.oauth  (sem o .example)
#   2. Preencha os tres campos abaixo
#   3. Rode:  node scripts/nuvemshop-token.mjs
#   4. Ele imprime o access_token e o store_id para voce colar na tela do app
#   5. APAGUE o arquivo depois — o code so serve uma vez mesmo
#
# O arquivo preenchido e gitignored (padrao .env.* do .gitignore).

# App ID / Client ID da sua aplicacao (Portal de Parceiros)
NUVEMSHOP_CLIENT_ID=

# Client secret da mesma aplicacao (o mesmo que voce ja subiu como secret)
NUVEMSHOP_CLIENT_SECRET=

# O "code" que veio na URL de redirecionamento depois de autorizar.
# ATENCAO: expira em poucos minutos. Se der erro de "invalid_grant",
# refaca a autorizacao para pegar um code novo.
NUVEMSHOP_CODE=
